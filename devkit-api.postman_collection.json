    {
      "name": "Regular Expression Tester",
      "item": [
        {
          "name": "Regex Match (Global Emails)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pattern\": \"(\\\\w+)@(\\\\w+\\\\.\\\\w+)\",\n  \"flags\": \"g\",\n  \"text\": \"Contact me at dev@nodeframe.dev or test@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/regex/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "regex", "test"]
            },
            "description": "Tests regex pattern against text with global match extraction."
          }
        },
