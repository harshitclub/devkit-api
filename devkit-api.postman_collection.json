{
  "info": {
    "_postman_id": "b9f936f4-1234-4a56-8789-0123456789ab",
    "name": "DevKit API",
    "description": "Postman collection for DevKit API — Developer Utilities & Transformation Backend powered by NodeFrame (@harshitclub/nodeframe).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health & Meta",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Returns system health, uptime in seconds, memory usage, and framework information."
          }
        }
      ]
    },
    {
      "name": "JSON Formatter & Minifier",
      "item": [
        {
          "name": "Format JSON (Beautify)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"name\": \"DevKit API\",\n    \"features\": [\n      \"json-formatter\",\n      \"crypto-hasher\",\n      \"regex-tester\",\n      \"uuid-generator\",\n      \"slugifier\"\n    ],\n    \"framework\": \"@harshitclub/nodeframe\"\n  },\n  \"space\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/format/json",
              "host": ["{{baseUrl}}"],
              "path": ["api", "format", "json"]
            },
            "description": "Beautifies JSON data with custom indentation and size stats."
          }
        },
        {
          "name": "Minify JSON",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"name\": \"DevKit API\",\n    \"features\": [\"format\", \"hash\", \"regex\"],\n    \"fast\": true\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/format/json?minify=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "format", "json"],
              "query": [
                {
                  "key": "minify",
                  "value": "true"
                }
              ]
            },
            "description": "Minifies JSON removing all unnecessary whitespace."
          }
        }
      ]
    },
