            "url": {
              "raw": "{{baseUrl}}/api/regex/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "regex", "test"]
            },
            "description": "Tests regex pattern with case-insensitive flag."
          }
        }
      ]
